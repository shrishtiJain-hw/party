<?xml version="1.0" encoding="UTF-8"?>

<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-2.1.xsd">

    <!-- ===================== -->
    <!-- ACTIONS -->
    <!-- ===================== -->
    <actions>
        <set field="partyList"
             from="ec.entity.find('party.Party').list()"/>
    </actions>

    <!-- ===================== -->
    <!-- WIDGETS -->
    <!-- ===================== -->
    <widgets>
        <label type="h1" text="Party Screen"/>

        <container-dialog id="CreatePartyDialog" button-text="Create Party">
            <form-single name="CreatePartyForm" transition="createParty">
                <auto-fields-entity entity-name="party.Party" field-type="edit"/>
                <field name="submit">
                    <default-field title="Create">
                        <submit/>
                    </default-field>
                </field>
            </form-single>
        </container-dialog>

        <label text=" "/>

        <!-- LIST -->
        <form-list name="PartyList" list="partyList" skip-form="true">
            <auto-fields-entity entity-name="party.Party" field-type="display"/>
        </form-list>
    </widgets>

    <!-- ===================== -->
    <!-- TRANSITION -->
    <!-- ===================== -->
    <transition name="createParty">
        <service-call name="create#party.Party"/>
        <default-response url="."/>
    </transition>

</screen>