<?xml version="1.0" encoding="UTF-8"?>
<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/service-definition-2.1.xsd">

    <service verb="create" noun="Person" type="script" authenticate="false" allow-remote="true"
            location="component://party/script/party/PersonServices.groovy">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="firstName" required="true"/>
            <parameter name="lastName" required="true"/>
            <parameter name="dateOfBirth" type="Date"/>
            <parameter name="*"/>
        </in-parameters>
        <out-parameters>
            <parameter name="response" required="true"/>
        </out-parameters>
    </service>

    <service verb="update" noun="Person" type="script" authenticate="false" allow-remote="true"
            location="component://party/script/party/UpdatePerson.groovy">
        <in-parameters>
            <parameter name="partyId" required="true"/>
            <parameter name="firstName"/>
            <parameter name="lastName"/>
            <parameter name="dateOfBirth" type="Date"/>
            <parameter name="*"/>
        </in-parameters>
        <out-parameters>
            <parameter name="response" required="true"/>
        </out-parameters>
    </service>

    <service verb="delete" noun="Person" type="script" authenticate="false" allow-remote="true"
            location="component://party/script/party/DeletePerson.groovy">
        <in-parameters>
            <parameter name="partyId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="response" required="true"/>
        </out-parameters>
    </service>

    <service verb="get" noun="Person" type="script" authenticate="false" allow-remote="true"
            location="component://party/script/party/GetPerson.groovy">
        <in-parameters>
            <parameter name="partyId" required="true"/>
        </in-parameters>
        <out-parameters>
            <parameter name="partyId"/>
            <parameter name="firstName"/>
            <parameter name="lastName"/>
            <parameter name="dateOfBirth" type="Date"/>
        </out-parameters>
    </service>



</services>
