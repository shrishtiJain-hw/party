<?xml version="1.0" encoding="UTF-8"?>
<resource xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
          xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/rest-api-2.1.xsd"
          name="Person" require-authentication="false">
    <method type="post" require-authentication="false">
        <service name="party.PersonServices.create#Person"/>
    </method>
    <method type="put" require-authentication="false">
        <service name="party.PersonServices.update#Person"/>
    </method>
    <method type="delete" require-authentication="false">
        <service name="party.PersonServices.delete#Person"/>
    </method>
    <method type="get" require-authentication="false">
        <parameter name="partyId"/>
        <service name="party.PersonServices.get#Person"/>
    </method>

</resource>
